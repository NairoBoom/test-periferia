# Archivo de ejemplo de variables de entorno para el proyecto completo
# Copia este archivo en cada servicio según corresponda

# Auth Service
AUTH_PORT=3001
AUTH_DB_HOST=postgres
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_NAME=social_network
JWT_SECRET=periferiatest
JWT_EXPIRES_IN=24h

# Posts Service
POSTS_PORT=3002
POSTS_DB_HOST=postgres
POSTS_DB_PORT=5432
POSTS_DB_USER=postgres
POSTS_DB_PASSWORD=postgres
POSTS_DB_NAME=social_network
POSTS_AUTH_SERVICE_URL=http://auth-service:3001

# Users Service
USERS_PORT=3003
USERS_DB_HOST=postgres
USERS_DB_PORT=5432
USERS_DB_USER=postgres
USERS_DB_PASSWORD=postgres
USERS_DB_NAME=social_network
USERS_AUTH_SERVICE_URL=http://auth-service:3001

# Frontend
VITE_AUTH_SERVICE_URL=http://localhost:3001
VITE_POSTS_SERVICE_URL=http://localhost:3002
VITE_USERS_SERVICE_URL=http://localhost:3003

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_network
